# Google Maps API Key
# Replace YOUR_GOOGLE_MAPS_API_KEY below with your actual API key
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Real-Time Weather API Key (Optional OpenWeatherMap API key fallback to Open-Meteo)
VITE_OPENWEATHER_API_KEY=
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

